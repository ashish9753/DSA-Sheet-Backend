MONGODB_URI=your_mongodb_connection_string
# Use a long random string. In production the server refuses to start without it.
JWT_SECRET=your_jwt_secret
PORT=5000
GOOGLE_CLIENT_ID=971496737518-r6ghl3vudfup2jlalm5d8pdq4ej904om.apps.googleusercontent.com
# Set to "production" on the live server to enforce the strict security checks.
NODE_ENV=production
# Comma-separated extra origins allowed by CORS (ashishdev.com is always allowed).
ALLOWED_ORIGINS=
# Long random string used to anonymise visitors in traffic analytics.
# Falls back to JWT_SECRET if unset. Changing it only resets today's unique count.
ANALYTICS_SALT=
